# Copy this file to .env and fill in the Google values.

INSTITUTION_NAME="Admissions Office"
ACADEMIC_YEAR="2026–27"
PUBLIC_BASE_URL="http://localhost:8080"
PORT="8080"

# Long random strings. The setup key signs the office into /admin.
FLASK_SECRET_KEY=change-me
ADMIN_SETUP_KEY=change-me

# OAuth client of type "Web application" from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Leave blank to connect the Google account from /admin instead.
GOOGLE_REFRESH_TOKEN=

# The id in https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# A full spreadsheet URL is also accepted.
SPREADSHEET_ID=
SHEET_NAME=Admissions

# Set to 1 only when the app sits behind a reverse proxy.
TRUST_PROXY=0
